# Restricted API key (rk_test_... / rk_live_...) preferred, or a secret key (sk_...).
# The Stripe SDK accepts either value in this variable.
# Never commit real keys. https://docs.stripe.com/keys-best-practices
STRIPE_SECRET_KEY=

# Not used by Stripe-hosted Checkout. Reserved so a future embedded Checkout
# or Payment Element can read it without renaming variables.
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_...).
# Local: printed by `stripe listen`. Live: Dashboard webhook destination.
STRIPE_WEBHOOK_SECRET=

# Public base URL of this app, no trailing slash.
# Checkout success/cancel URLs and the Customer Portal return URL are built from it.
APP_URL=http://localhost:4242

PORT=4242

# Test-mode Price IDs already created for TD Digital Labs.
# The server maps plan keys to these IDs. The browser never sends a price.
# Replace them with live-mode Price IDs before going live.
STRIPE_PRICE_BASIC=price_1Ua1iTRclY2Jm8PTvaQc59H7
STRIPE_PRICE_PRO=price_1Ua1iaRclY2Jm8PTE7WRRG23
STRIPE_PRICE_ONE_TIME=price_1Ua1icRclY2Jm8PTr7vkKGqe
